  "schema_sql": "-- schema generated by pg-rehearse from system catalogs (no data)\nSET check_function_bodies = false;\n\nCREATE SCHEMA IF NOT EXISTS public;\n\nCREATE EXTENSION IF NOT EXISTS pg_stat_statements WITH SCHEMA public;\n\nCREATE TYPE public.order_status AS ENUM ('pending', 'paid', 'shipped', 'delivered', 'cancelled', 'refunded');\n\nCREATE TYPE public.payment_status AS ENUM ('authorized', 'captured', 'failed', 'refunded');\n\nCREATE TABLE public.order_items (\n    id bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,\n    order_id bigint NOT NULL,\n    product_id bigint NOT NULL,\n    quantity integer NOT NULL,\n    unit_price numeric(10,2) NOT NULL\n);\n\nCREATE TABLE public.orders (\n    id bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,\n    user_id bigint,\n    status public.order_status DEFAULT 'pending'::public.order_status NOT NULL,\n    total numeric DEFAULT 0 NOT NULL,\n    currency character(3) DEFAULT 'USD'::bpchar NOT NULL,\n    created_at timestamp with time zone DEFAULT now() NOT NULL,\n    updated_at timestamp with time zone DEFAULT now() NOT NULL\n);\n\nCREATE TABLE public.payments (\n    id bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,\n    order_id bigint NOT NULL,\n    provider text NOT NULL,\n    provider_ref text NOT NULL,\n    amount numeric(12,2) NOT NULL,\n    status public.payment_status NOT NULL,\n    created_at timestamp with time zone DEFAULT now() NOT NULL\n);\n\nCREATE TABLE public.products (\n    id bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,\n    sku text NOT NULL,\n    name text NOT NULL,\n    category text NOT NULL,\n    price numeric(10,2) NOT NULL,\n    stock integer DEFAULT 0 NOT NULL,\n    description text,\n    created_at timestamp with time zone DEFAULT now() NOT NULL\n);\n\nCREATE TABLE public.users (\n    id bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,\n    email text NOT NULL,\n    name text NOT NULL,\n    country character(2) DEFAULT 'US'::bpchar NOT NULL,\n    created_at timestamp with time zone DEFAULT now() NOT NULL\n);\n\nALTER TABLE public.order_items ADD CONSTRAINT order_items_pkey PRIMARY KEY (id);\n\nALTER TABLE public.orders ADD CONSTRAINT orders_pkey PRIMARY KEY (id);\n\nALTER TABLE public.payments ADD CONSTRAINT payments_pkey PRIMARY KEY (id);\n\nALTER TABLE public.products ADD CONSTRAINT products_pkey PRIMARY KEY (id);\n\nALTER TABLE public.users ADD CONSTRAINT users_pkey PRIMARY KEY (id);\n\nALTER TABLE public.products ADD CONSTRAINT products_sku_key UNIQUE (sku);\n\nALTER TABLE public.users ADD CONSTRAINT users_email_key UNIQUE (email);\n\nALTER TABLE public.order_items ADD CONSTRAINT order_items_quantity_check CHECK ((quantity \u003e 0));\n\nALTER TABLE public.products ADD CONSTRAINT products_price_check CHECK ((price \u003e= (0)::numeric));\n\nCREATE INDEX order_items_order_id_idx ON public.order_items USING btree (order_id);\n\nCREATE INDEX order_items_product_id_idx ON public.order_items USING btree (product_id);\n\nCREATE INDEX orders_open_status_idx ON public.orders USING btree (status) WHERE (status = ANY (ARRAY['pending'::public.order_status, 'paid'::public.order_status]));\n\nCREATE INDEX orders_user_id_idx ON public.orders USING btree (user_id);\n\nCREATE INDEX payments_order_id_idx ON public.payments USING btree (order_id);\n\nCREATE INDEX products_category_idx ON public.products USING btree (category);\n\nALTER TABLE public.order_items ADD CONSTRAINT order_items_order_id_fkey FOREIGN KEY (order_id) REFERENCES public.orders(id) ON DELETE CASCADE;\n\nALTER TABLE public.order_items ADD CONSTRAINT order_items_product_id_fkey FOREIGN KEY (product_id) REFERENCES public.products(id);\n\nALTER TABLE public.orders ADD CONSTRAINT orders_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id);\n\nCREATE VIEW public.daily_revenue AS SELECT (date_trunc('day'::text, o.created_at))::date AS day,\n    p.category,\n    count(DISTINCT o.id) AS orders,\n    sum(((oi.quantity)::numeric * oi.unit_price)) AS revenue\n   FROM ((public.orders o\n     JOIN public.order_items oi ON ((oi.order_id = o.id)))\n     JOIN public.products p ON ((p.id = oi.product_id)))\n  WHERE (o.status = ANY (ARRAY['paid'::public.order_status, 'shipped'::public.order_status, 'delivered'::public.order_status]))\n  GROUP BY ((date_trunc('day'::text, o.created_at))::date), p.category;\n\n",
